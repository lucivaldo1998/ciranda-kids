# Banco Postgres (Supabase): Dashboard → Connect → "Transaction pooler" (porta 6543)
DATABASE_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

# Senha do painel administrativo (/admin/login). Troque antes de publicar.
ADMIN_PASSWORD="ciranda123"

# Chave usada para cifrar (AES-256-GCM) as chaves dos gateways e da IA no banco.
# Qualquer string longa e aleatória. Trocar depois invalida as chaves já salvas.
SETTINGS_ENCRYPTION_KEY="troque-por-uma-string-longa-e-aleatoria"

# URL pública do site (redirects de pagamento e webhooks)
NEXT_PUBLIC_SITE_URL="https://seu-dominio.vercel.app"

# Uploads em produção (Vercel → Storage → Blob → cria o token automaticamente).
# Sem isso na Vercel, o upload de fotos pelo painel não persiste.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
